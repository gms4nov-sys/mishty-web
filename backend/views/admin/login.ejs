<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login — Mishty Web</title>
<link rel="stylesheet" href="/admin/public/admin.css">
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <h1>Mishty<span>Web</span></h1>
    <p>Admin panel login</p>
    <% if (error) { %>
      <div class="error-msg"><%= error %></div>
    <% } %>
    <form action="/admin/login" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn full">Log In</button>
    </form>
  </div>
</div>
</body>
</html>
