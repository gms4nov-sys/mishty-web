PORT=4000
NODE_ENV=production

# Generate your own random value — run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# Comma-separated list of origins allowed to call /api/* (your live site domain(s)).
# Leave blank in development to allow all origins.
CORS_ORIGIN=https://yourdomain.com

# Change these before first deploy — do NOT ship with the default value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_now_do_not_use_default
